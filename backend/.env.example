# Se a porta 5432 ja estiver ocupada, mude POSTGRES_PORT
# e a porta na SPRING_DATASOURCE_URL para o mesmo valor (ex.: 5433).
POSTGRES_PORT=5432
SPRING_DATASOURCE_DB=farmacia
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/farmacia
SPRING_DATASOURCE_USERNAME=farmacia
SPRING_DATASOURCE_PASSWORD=
